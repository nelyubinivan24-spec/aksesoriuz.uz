---
import { site, type Locale } from "@data/site";
import { labels } from "@lib/i18n";

const { locale } = Astro.props as { locale: Locale };
const t = labels[locale];
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-line-200 bg-white/95 px-3 py-2 shadow-lg backdrop-blur md:hidden">
  <div class="grid grid-cols-3 gap-2">
    <a class="rounded-md border border-line-200 px-3 py-2 text-center text-xs font-semibold text-ink-950" href={`tel:${site.contacts.phonePrimary}`}>{t.call}</a>
    <a class="rounded-md border border-line-200 px-3 py-2 text-center text-xs font-semibold text-ink-950" href={site.contacts.telegram}>{t.messenger}</a>
    <a class="rounded-md bg-emerald-700 px-3 py-2 text-center text-xs font-semibold text-white" href={`/${locale}/contact/?intent=quote`}>{t.requestQuote}</a>
  </div>
</div>
