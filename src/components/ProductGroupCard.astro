---
type Props = {
  title: string;
  description: string;
  href: string;
  tags: string[];
  ctaLabel?: string;
  imageSrc?: string;
  imageAlt?: string;
  eyebrow?: string;
};

const { title, description, href, tags, ctaLabel = "View category", imageSrc, imageAlt = "", eyebrow } = Astro.props as Props;
---

<article class="group flex min-h-[410px] flex-col overflow-hidden rounded-md border border-line-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-emerald-700 hover:shadow-xl">
  <div>
    <div class="relative aspect-[4/3] overflow-hidden bg-ink-950">
      {imageSrc ? (
        <img class="h-full w-full object-cover transition duration-500 group-hover:scale-105" src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
      ) : (
        <div class="h-full w-full bg-[linear-gradient(135deg,#111827,#2f3742_52%,#047857)]"></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-ink-950/75 via-ink-950/10 to-transparent"></div>
      {eyebrow && <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-ink-950">{eyebrow}</span>}
    </div>
    <div class="p-5">
      <h3 class="text-xl font-semibold leading-snug text-ink-950">{title}</h3>
      <p class="mt-3 text-sm leading-6 text-steel-600">{description}</p>
    </div>
    <div class="px-5">
      <div class="flex flex-wrap gap-2">
      {tags.map((tag) => <span class="rounded-full bg-mist-100 px-3 py-1 text-xs font-medium text-graphite-800">{tag}</span>)}
      </div>
    </div>
  </div>
  <div class="mt-auto p-5">
    <a class="inline-flex min-h-11 w-full items-center justify-center rounded-md border border-line-200 text-sm font-semibold text-ink-950 transition hover:border-emerald-700 hover:text-emerald-700" href={href}>{ctaLabel}</a>
  </div>
</article>
