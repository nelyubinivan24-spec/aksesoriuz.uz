---
type Props = {
  title: string;
  description: string;
  href: string;
  tags: string[];
  ctaLabel?: string;
};

const { title, description, href, tags, ctaLabel = "View category" } = Astro.props as Props;
---

<article class="flex min-h-72 flex-col justify-between rounded-md border border-line-200 bg-white p-5 transition hover:border-emerald-700">
  <div>
    <div class="h-36 rounded-md bg-mist-100"></div>
    <h3 class="mt-5 text-xl font-semibold text-ink-950">{title}</h3>
    <p class="mt-2 text-sm leading-6 text-steel-600">{description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((tag) => <span class="rounded-full bg-mist-100 px-3 py-1 text-xs font-medium text-graphite-800">{tag}</span>)}
    </div>
  </div>
  <a class="mt-5 inline-flex text-sm font-semibold text-emerald-700" href={href}>{ctaLabel}</a>
</article>
