---
import BaseLayout from "@layouts/BaseLayout.astro";

const faqs = [
  {
    question: "How do I request a calculation?",
    answer: "Send a request through the form, phone, or messenger. For an accurate quote, share the product, quantity, material, logo, and desired timing."
  },
  {
    question: "Can products be made with a logo?",
    answer: "Yes. UV printing, laser cutting and engraving, embossing, foiling, printing, and marking are available."
  },
  {
    question: "Is there a price catalog?",
    answer: "Pricing depends on material, quantity, size, and branding. For an accurate quote, send order parameters or request the current price catalog from a manager."
  },
  {
    question: "Which product categories are available?",
    answer: "Restaurant and hotel accessories, business products, packaging, souvenir products, uniforms, textile, and production services."
  },
  {
    question: "Can several product types be requested together?",
    answer: "Yes. Several product references can be discussed in one B2B calculation request so the manager can prepare a combined proposal."
  }
];
---

<BaseLayout locale="en" path="/en/faq/" pathWithoutLocale="faq/" title="FAQ | Aksessoriuz" description="Answers to common questions about calculation, branding, catalog, product categories, and Aksessoriuz orders.">
  <section class="bg-mist-100 py-16">
    <div class="container-page">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">FAQ</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold text-ink-950 md:text-5xl">Frequently asked questions</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-steel-600">Answers about calculation, branding, product categories, timing, and the B2B order format.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page max-w-4xl">
      <div class="grid gap-4">
        {faqs.map((item) => (
          <article class="rounded-md border border-line-200 bg-white p-5">
            <h2 class="text-lg font-semibold text-ink-950">{item.question}</h2>
            <p class="mt-2 text-sm leading-6 text-steel-600">{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
