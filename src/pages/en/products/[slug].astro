---
import ProductCard from "@components/ProductCard.astro";
import QuoteForm from "@components/QuoteForm";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getProductCategoryLinks, getRelatedProducts, products } from "@data/products";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug.en },
    props: { product }
  }));
}

const { product } = Astro.props;
const categoryLinks = getProductCategoryLinks(product, "en");
const relatedProducts = getRelatedProducts(product);
---

<BaseLayout
  locale="en"
  path={`/en/products/${product.slug.en}/`}
  pathWithoutLocale={`products/${product.slug.en}/`}
  title={`${product.title.en} | Aksessoriuz`}
  description={product.description.en}
>
  <section class="bg-mist-100 py-16 md:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="overflow-hidden rounded-md border border-line-200 bg-white">
        <img class="aspect-square w-full object-cover" src={product.image.src} alt={product.image.alt.en} loading="eager" decoding="async" />
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass-500">SKU {product.sku}</p>
        <h1 class="mt-4 text-4xl font-semibold text-ink-950 md:text-5xl">{product.title.en}</h1>
        <p class="mt-5 text-lg leading-8 text-steel-600">{product.description.en}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {categoryLinks.map((link) => <a class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-ink-950 transition hover:text-emerald-700" href={link.href}>{link.title}</a>)}
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="inline-flex min-h-12 items-center justify-center rounded-md bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-teal-600" href={`/en/contact/?intent=product&product=${product.id}`}>Add to inquiry</a>
          <a class="inline-flex min-h-12 items-center justify-center rounded-md border border-line-200 bg-white px-5 text-sm font-semibold text-ink-950 transition hover:border-emerald-700" href={product.legacyUrl}>Open current-site card</a>
        </div>
        <p class="mt-5 rounded-md border border-line-200 bg-white p-4 text-sm leading-6 text-steel-600">
          This card is a temporary draft based on the current website. After final product cards are provided, this page will include exact dimensions, material options, timing, MOQ, and gallery assets.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <h2 class="text-3xl font-semibold text-ink-950">Quote parameters</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">The temporary structure shows which data a manager needs for an accurate B2B calculation.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="rounded-md border border-line-200 bg-white p-5">
          <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-steel-600">Materials</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {product.materials.map((item) => <span class="rounded-full bg-mist-100 px-3 py-1 text-xs font-medium text-graphite-800">{item.en}</span>)}
          </div>
        </div>
        <div class="rounded-md border border-line-200 bg-white p-5">
          <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-steel-600">Branding</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {product.brandingMethods.map((item) => <span class="rounded-full bg-mist-100 px-3 py-1 text-xs font-medium text-graphite-800">{item.en}</span>)}
          </div>
        </div>
        <div class="rounded-md border border-line-200 bg-white p-5">
          <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-steel-600">For whom</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {product.industries.map((item) => <span class="rounded-full bg-mist-100 px-3 py-1 text-xs font-medium text-graphite-800">{item.en}</span>)}
          </div>
        </div>
        <div class="rounded-md border border-line-200 bg-white p-5">
          <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-steel-600">Status</h3>
          <p class="mt-4 text-sm leading-6 text-steel-600">Draft card, ready to be replaced with final client-approved data.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist-100 py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_0.9fr] lg:items-start">
      <div>
        <h2 class="text-3xl font-semibold text-ink-950">Request calculation</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">Send the SKU, quantity, and preferences. The form already passes page context through the request source.</p>
      </div>
      <QuoteForm client:idle locale="en" source={`product_${product.id}`} />
    </div>
  </section>

  {relatedProducts.length > 0 && (
    <section class="py-16">
      <div class="container-page">
        <h2 class="text-3xl font-semibold text-ink-950">Related positions</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {relatedProducts.map((item) => <ProductCard product={item} locale="en" />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
