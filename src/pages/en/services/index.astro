---
import ProductGroupCard from "@components/ProductGroupCard.astro";
import QuoteForm from "@components/QuoteForm";
import BaseLayout from "@layouts/BaseLayout.astro";
import { capabilities, catalogGroups } from "@data/catalog";
---

<BaseLayout
  locale="en"
  path="/en/services/"
  pathWithoutLocale="services/"
  title="Production services | Aksessoriuz"
  description="UV printing, printing, foiling, laser cutting and engraving, embossing, marking, food photography, souvenir products, uniforms, and carpentry production."
>
  <section class="bg-mist-100 py-16 md:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_0.85fr] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Production capabilities</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-semibold text-ink-950 md:text-5xl">Production services</h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-steel-600">
          The full capability list from the current site is preserved and each technology is connected to products, materials, and quote requests.
        </p>
        <div class="mt-8 grid gap-3 text-sm text-graphite-800 sm:grid-cols-2">
          <div class="rounded-md border border-line-200 bg-white p-4">
            <span class="block text-2xl font-semibold text-ink-950">{capabilities.length}</span>
            <span class="mt-1 block text-steel-600">service directions</span>
          </div>
          <div class="rounded-md border border-line-200 bg-white p-4">
            <span class="block text-2xl font-semibold text-ink-950">{catalogGroups.length}</span>
            <span class="mt-1 block text-steel-600">connected product groups</span>
          </div>
        </div>
      </div>
      <QuoteForm client:idle locale="en" source="services_index" />
    </div>
  </section>

  <section class="py-16">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink-950">All capabilities</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">This list keeps the commercial coverage of the current site while moving it into the new structure.</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {capabilities.map((item) => (
          <a class="rounded-md border border-line-200 bg-white p-5 transition hover:border-emerald-700" href={`/en/services/${item.slug.en}/`}>
            <h3 class="text-lg font-semibold text-ink-950">{item.title.en}</h3>
            <p class="mt-2 text-sm leading-6 text-steel-600">{item.description.en}</p>
            <span class="mt-4 inline-flex text-sm font-semibold text-emerald-700">Details</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist-100 py-16">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink-950">How services connect to products</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">A buyer can enter through either a product or a technology, such as menus, folders, packaging, uniforms, or laser engraving.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {catalogGroups.map((group) => (
          <ProductGroupCard
            title={group.title.en}
            description={group.description.en}
            href={`/en/catalog/${group.slug.en}/`}
            tags={group.tags.map((tag) => tag.en)}
            ctaLabel="View products"
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
