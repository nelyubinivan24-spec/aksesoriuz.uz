---
import ProductGroupCard from "@components/ProductGroupCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { catalogGroups } from "@data/catalog";
---

<BaseLayout locale="en" path="/en/catalog/" pathWithoutLocale="catalog/" title="Branded product catalog | Aksessoriuz" description="Catalog of branded products, packaging, accessories, uniforms, and production services by Aksessoriuz.">
  <section class="bg-mist-100 py-16">
    <div class="container-page">
      <h1 class="max-w-3xl text-4xl font-semibold text-ink-950">Product catalog</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-steel-600">Browse by industry, product type, material, or production technology. Each category leads to references, batch calculation, and custom execution discussion.</p>
    </div>
  </section>
  <section class="py-16">
    <div class="container-page grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {catalogGroups.map((category) => (
        <ProductGroupCard
          title={category.title.en}
          description={category.description.en}
          href={`/en/catalog/${category.slug.en}/`}
          tags={category.tags.map((tag) => tag.en)}
          ctaLabel="Open category"
          imageSrc={category.image.src}
          imageAlt={category.image.alt.en}
          eyebrow={category.priority === "high" ? "Priority" : "Production"}
        />
      ))}
    </div>
  </section>
</BaseLayout>
