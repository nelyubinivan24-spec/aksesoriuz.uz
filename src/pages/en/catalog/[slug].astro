---
import BaseLayout from "@layouts/BaseLayout.astro";
import { catalogGroups } from "@data/catalog";
import { getLegacySubcategoriesByGroup } from "@data/catalogCoverage";
import { legacyProductMigration } from "@data/legacyMigration";
import ProductCard from "@components/ProductCard.astro";
import { getProductsByCatalogGroupId } from "@data/products";

export function getStaticPaths() {
  return catalogGroups.map((group) => ({
    params: { slug: group.slug.en },
    props: { group }
  }));
}

const { group } = Astro.props;
const products = getProductsByCatalogGroupId(group.id);
const subcategories = getLegacySubcategoriesByGroup(group.id);
const legacyCount = (familyIds: readonly string[]) => legacyProductMigration.filter((record) => familyIds.includes(record.familyId)).length;
const legacyLabel = (legacySlug: string) => group.subcategories.find((item) => item.originalSlug === legacySlug)?.label.en;
---

<BaseLayout
  locale="en"
  path={`/en/catalog/${group.slug.en}/`}
  pathWithoutLocale={`catalog/${group.slug.en}/`}
  title={`${group.title.en} | Aksessoriuz`}
  description={group.description.en}
>
  <section class="relative overflow-hidden bg-ink-950 py-16 text-white md:py-20">
    <img class="absolute inset-0 h-full w-full object-cover opacity-45" src={group.image.src} alt={group.image.alt.en} loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/82 to-ink-950/30"></div>
    <div class="container-page relative">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass-500">Catalog direction</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold text-white">{group.title.en}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-white/74">{group.description.en}</p>
      <div class="mt-8 flex flex-wrap gap-2">
        {group.tags.map((tag) => <span class="rounded-full bg-white/12 px-3 py-1 text-xs font-medium text-white">{tag.en}</span>)}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Product references</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink-950">Reference items based on the current site</h2>
        </div>
        <p class="text-base leading-7 text-steel-600">
          This is not an online store. These items are B2B project references: a buyer can choose a similar item, request a sample, or discuss custom execution.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => <ProductCard product={product} locale="en" />)}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
      <div>
        <h2 class="text-2xl font-semibold text-ink-950">Current-site subcategories</h2>
        <p class="mt-4 text-sm leading-6 text-steel-600">These directions now lead to B2B landing pages: clients choose a product type, review references, and submit a project brief.</p>
      </div>
      <div class="grid gap-3 md:grid-cols-2">
        {subcategories.map((item) => (
          <a class="rounded-md border border-line-200 bg-white p-4 transition hover:-translate-y-0.5 hover:border-emerald-700 hover:shadow-sm" href={`/en/catalog/${group.slug.en}/${item.slug.en}/`}>
            <span class="text-sm font-semibold text-ink-950">{legacyLabel(item.legacySlug) ?? item.title}</span>
            <span class="mt-2 block text-xs leading-5 text-steel-600">Preserved from the current structure: {item.legacySlug}. Connected to {legacyCount(item.productFamilyIds)} legacy URLs in the migration manifest.</span>
            <span class="mt-3 inline-flex text-xs font-semibold text-emerald-700">Open direction</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
