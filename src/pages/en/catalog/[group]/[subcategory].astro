---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProductCard from "@components/ProductCard.astro";
import { catalogGroups } from "@data/catalog";
import { legacySubcategoryCoverage } from "@data/catalogCoverage";
import { getProductFamilyProfiles } from "@data/productFamilies";
import { getProductsByFamilyIds } from "@data/products";

export function getStaticPaths() {
  return legacySubcategoryCoverage.map((item) => {
    const group = catalogGroups.find((catalogGroup) => catalogGroup.id === item.groupId);
    if (!group) {
      throw new Error(`Missing catalog group for ${item.id}`);
    }

    return {
      params: {
        group: group.slug.en,
        subcategory: item.slug.en
      },
      props: { group, item }
    };
  });
}

const { group, item } = Astro.props;
const categoryLabel = group.subcategories.find((subcategory) => subcategory.originalSlug === item.legacySlug)?.label.en;
const title = categoryLabel ?? item.title;
const familyProfiles = getProductFamilyProfiles(item.productFamilyIds);
const products = getProductsByFamilyIds(item.productFamilyIds, group.id);
const briefHref = `/en/contact/?intent=subcategory-brief&category=${group.id}&subcategory=${item.id}`;
---

<BaseLayout
  locale="en"
  path={`/en/catalog/${group.slug.en}/${item.slug.en}/`}
  pathWithoutLocale={`catalog/${group.slug.en}/${item.slug.en}/`}
  title={`${title} | Aksessoriuz`}
  description={`${title}: custom-made products, materials, branding, and batch quotation for B2B clients.`}
>
  <section class="relative overflow-hidden bg-ink-950 py-16 text-white md:py-20">
    <img class="absolute inset-0 h-full w-full object-cover opacity-40" src={group.image.src} alt={group.image.alt.en} loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/88 to-ink-950/35"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ink-950 to-transparent"></div>
    <div class="container-page relative">
      <a class="inline-flex text-sm font-semibold text-brass-500 transition hover:text-white" href={`/en/catalog/${group.slug.en}/`}>Back to category</a>
      <p class="mt-6 text-sm font-semibold uppercase tracking-[0.18em] text-white/62">Custom-made products</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold text-white">{title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-white/74">
        Select product type, material, branding method, and approximate quantity. A manager will clarify details and prepare a quote around the business task.
      </p>
      <div class="mt-8 grid gap-3 sm:grid-cols-3">
        <div class="rounded-md border border-white/12 bg-white/10 p-4">
          <p class="text-2xl font-semibold text-white">{familyProfiles.length}</p>
          <p class="mt-1 text-xs uppercase tracking-[0.14em] text-white/58">product families</p>
        </div>
        <div class="rounded-md border border-white/12 bg-white/10 p-4">
          <p class="text-2xl font-semibold text-white">{products.length > 0 ? products.length : "Selection"}</p>
          <p class="mt-1 text-xs uppercase tracking-[0.14em] text-white/58">options for quotation</p>
        </div>
        <div class="rounded-md border border-white/12 bg-white/10 p-4">
          <p class="text-2xl font-semibold text-white">B2B</p>
          <p class="mt-1 text-xs uppercase tracking-[0.14em] text-white/58">batch around a task</p>
        </div>
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="inline-flex min-h-12 items-center justify-center rounded-md bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-teal-600" href={briefHref}>Request quote</a>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Direction scope</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink-950">Product families and use scenarios</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">This section helps buyers choose the right product type and form a quotation request faster.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {familyProfiles.map((family) => (
          <div class="rounded-md border border-line-200 bg-white p-5">
            <p class="text-sm font-semibold text-ink-950">{family.title.en}</p>
            <p class="mt-3 text-sm leading-6 text-steel-600">{family.summary.en}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {family.bestFor.map((tag) => <span class="rounded-full bg-mist-100 px-3 py-1 text-xs font-medium text-graphite-800">{tag.en}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist-100 py-16">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Products</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink-950">Options for quotation and discussion</h2>
        </div>
        <p class="text-base leading-7 text-steel-600">Each product can be adapted by material, brand colors, logo, quantity, timing, and use scenario.</p>
      </div>
      {products.length > 0 ? (
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {products.slice(0, 9).map((product) => <ProductCard product={product} locale="en" />)}
        </div>
      ) : (
        <div class="mt-10 rounded-md border border-line-200 bg-white p-6">
          <p class="text-base font-semibold text-ink-950">This direction is available through custom selection.</p>
          <p class="mt-3 text-sm leading-6 text-steel-600">Describe the task, preferred material, quantity, and branding. A manager will suggest suitable options and prepare a quote.</p>
        </div>
      )}
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-8 rounded-md bg-ink-950 p-8 text-white md:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass-500">Batch quotation</p>
        <h2 class="mt-3 text-3xl font-semibold text-white">Need a product selected for your brand?</h2>
        <p class="mt-4 max-w-3xl text-base leading-7 text-white/70">Send product type, approximate quantity, materials, logo, and timing. A manager will clarify details and prepare a proposal.</p>
      </div>
      <a class="inline-flex min-h-12 items-center justify-center rounded-md bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-teal-600" href={briefHref}>Send request</a>
    </div>
  </section>
</BaseLayout>
