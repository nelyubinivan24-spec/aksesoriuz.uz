---
import ProductGroupCard from "@components/ProductGroupCard.astro";
import QuoteForm from "@components/QuoteForm";
import BaseLayout from "@layouts/BaseLayout.astro";
import { capabilities, catalogGroups } from "@data/catalog";
---

<BaseLayout
  locale="en"
  path="/en/"
  pathWithoutLocale=""
  title="Aksessoriuz — branded products, packaging and accessories for business"
  description="Custom branded products, packaging, accessories, uniforms, and business gifts for restaurants, hotels, retail, and companies in Uzbekistan."
>
  <section class="bg-mist-100 py-16 md:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Custom branded production</p>
        <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-tight text-ink-950 md:text-6xl">
          Branded business details people see, touch, and remember
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-steel-600">
          We produce menu covers, packaging, corporate gifts, uniforms, and branded accessories for restaurants, hotels, retail, and companies.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="inline-flex min-h-12 items-center justify-center rounded-md bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-teal-600" href="/en/contact/?intent=quote">Request calculation</a>
          <a class="inline-flex min-h-12 items-center justify-center rounded-md border border-line-200 bg-white px-5 text-sm font-semibold text-ink-950 transition hover:border-emerald-700" href="/en/catalog/">View catalog</a>
        </div>
      </div>
      <QuoteForm client:idle locale="en" source="home_hero" />
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink-950">Complete product structure</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">We preserve the current site coverage: restaurant and hotel accessories, business products, packaging, uniforms, and production services.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {catalogGroups.map((group) => (
          <ProductGroupCard
            title={group.title.en}
            description={group.description.en}
            href={`/en/catalog/${group.slug.en}/`}
            tags={group.tags.map((tag) => tag.en)}
            ctaLabel="View direction"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist-100 py-16 md:py-24">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink-950">Production capabilities</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">The new site keeps all service and capability directions from the current website and connects them to products.</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {capabilities.map((item) => (
          <a class="rounded-md border border-line-200 bg-white p-5 transition hover:border-emerald-700" href={`/en/services/${item.slug.en}/`}>
            <h3 class="text-lg font-semibold text-ink-950">{item.title.en}</h3>
            <p class="mt-2 text-sm leading-6 text-steel-600">{item.description.en}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
