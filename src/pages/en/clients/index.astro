---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout locale="en" path="/en/clients/" pathWithoutLocale="clients/" title="Clients | Aksessoriuz" description="Aksessoriuz clients, industries, testimonials, and public work proof.">
  <section class="bg-mist-100 py-16">
    <div class="container-page">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Clients</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold text-ink-950 md:text-5xl">Clients</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-steel-600">Public cases, industries, and testimonials help buyers evaluate branded production experience for different business types.</p>
      <a class="mt-8 inline-flex min-h-12 items-center justify-center rounded-md bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-teal-600" href="/en/work/">View work and cases</a>
    </div>
  </section>
</BaseLayout>
