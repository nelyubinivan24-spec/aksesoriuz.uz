---
import BaseLayout from "@layouts/BaseLayout.astro";
import { catalogGroups } from "@data/catalog";
import ProductCard from "@components/ProductCard.astro";
import { getProductsByCatalogGroupId } from "@data/products";

export function getStaticPaths() {
  return catalogGroups.map((group) => ({
    params: { slug: group.slug.ru },
    props: { group }
  }));
}

const { group } = Astro.props;
const products = getProductsByCatalogGroupId(group.id);
---

<BaseLayout
  locale="ru"
  path={`/ru/catalog/${group.slug.ru}/`}
  pathWithoutLocale={`catalog/${group.slug.ru}/`}
  title={`${group.title.ru} | Aksessoriuz`}
  description={group.description.ru}
>
  <section class="relative overflow-hidden bg-ink-950 py-16 text-white md:py-20">
    <img class="absolute inset-0 h-full w-full object-cover opacity-45" src={group.image.src} alt={group.image.alt.ru} loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/82 to-ink-950/30"></div>
    <div class="container-page relative">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass-500">Catalog direction</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold text-white">{group.title.ru}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-white/74">{group.description.ru}</p>
      <div class="mt-8 flex flex-wrap gap-2">
        {group.tags.map((tag) => <span class="rounded-full bg-white/12 px-3 py-1 text-xs font-medium text-white">{tag.ru}</span>)}
      </div>
    </div>
  </section>
  <section class="py-16">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Product references</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink-950">Примеры изделий по текущему сайту</h2>
        </div>
        <p class="text-base leading-7 text-steel-600">
          Это не интернет-магазин, а B2B-набор ориентиров для проектного расчета. Клиент может выбрать похожее изделие, заказать образец или обсудить индивидуальное исполнение.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => <ProductCard product={product} locale="ru" />)}
      </div>
    </div>
  </section>
  <section class="py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
      <div>
        <h2 class="text-2xl font-semibold text-ink-950">Подкатегории текущего сайта</h2>
        <p class="mt-4 text-sm leading-6 text-steel-600">Эти направления перенесены из оригинальной структуры и будут связаны с новыми карточками товаров.</p>
      </div>
      <div class="grid gap-3 md:grid-cols-2">
        {group.subcategories.map((item) => (
          <a class="rounded-md border border-line-200 bg-white p-4 transition hover:border-emerald-700" href={`/ru/contact/?intent=category&category=${item.originalSlug}`}>
            <span class="text-sm font-semibold text-ink-950">{item.label.ru}</span>
            <span class="mt-2 block text-xs text-steel-600">Текущий раздел сохранен в таксономии: {item.originalSlug}</span>
            <span class="mt-3 inline-flex text-xs font-semibold text-emerald-700">Запросить подбор</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
