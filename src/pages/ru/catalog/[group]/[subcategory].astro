---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProductCard from "@components/ProductCard.astro";
import { catalogGroups } from "@data/catalog";
import { legacySubcategoryCoverage } from "@data/catalogCoverage";
import { getProductFamilyProfiles } from "@data/productFamilies";
import { getProductsByFamilyIds } from "@data/products";

export function getStaticPaths() {
  return legacySubcategoryCoverage.map((item) => {
    const group = catalogGroups.find((catalogGroup) => catalogGroup.id === item.groupId);
    if (!group) {
      throw new Error(`Missing catalog group for ${item.id}`);
    }

    return {
      params: {
        group: group.slug.ru,
        subcategory: item.slug.ru
      },
      props: { group, item }
    };
  });
}

const { group, item } = Astro.props;
const categoryLabel = group.subcategories.find((subcategory) => subcategory.originalSlug === item.legacySlug)?.label.ru;
const title = categoryLabel ?? item.title;
const familyProfiles = getProductFamilyProfiles(item.productFamilyIds);
const products = getProductsByFamilyIds(item.productFamilyIds, group.id);
const briefHref = `/ru/contact/?intent=subcategory-brief&category=${group.id}&subcategory=${item.id}`;
---

<BaseLayout
  locale="ru"
  path={`/ru/catalog/${group.slug.ru}/${item.slug.ru}/`}
  pathWithoutLocale={`catalog/${group.slug.ru}/${item.slug.ru}/`}
  title={`${title} | Aksessoriuz`}
  description={`${title}: изделия под заказ, материалы, брендирование и расчет партии для B2B-клиентов.`}
>
  <section class="relative overflow-hidden bg-ink-950 py-16 text-white md:py-20">
    <img class="absolute inset-0 h-full w-full object-cover opacity-40" src={group.image.src} alt={group.image.alt.ru} loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/88 to-ink-950/35"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ink-950 to-transparent"></div>
    <div class="container-page relative">
      <a class="inline-flex text-sm font-semibold text-brass-500 transition hover:text-white" href={`/ru/catalog/${group.slug.ru}/`}>Назад в раздел</a>
      <p class="mt-6 text-sm font-semibold uppercase tracking-[0.18em] text-white/62">Изделия под заказ</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold text-white">{title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-white/74">
        Подберите изделие, материал, способ брендирования и ориентировочный тираж. Менеджер уточнит детали и подготовит расчет под задачу бизнеса.
      </p>
      <div class="mt-8 grid gap-3 sm:grid-cols-3">
        <div class="rounded-md border border-white/12 bg-white/10 p-4">
          <p class="text-2xl font-semibold text-white">{familyProfiles.length}</p>
          <p class="mt-1 text-xs uppercase tracking-[0.14em] text-white/58">семейств изделий</p>
        </div>
        <div class="rounded-md border border-white/12 bg-white/10 p-4">
          <p class="text-2xl font-semibold text-white">{products.length > 0 ? products.length : "Подбор"}</p>
          <p class="mt-1 text-xs uppercase tracking-[0.14em] text-white/58">варианты для расчета</p>
        </div>
        <div class="rounded-md border border-white/12 bg-white/10 p-4">
          <p class="text-2xl font-semibold text-white">B2B</p>
          <p class="mt-1 text-xs uppercase tracking-[0.14em] text-white/58">партия под задачу</p>
        </div>
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="inline-flex min-h-12 items-center justify-center rounded-md bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-teal-600" href={briefHref}>Запросить расчет</a>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Что входит в направление</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink-950">Семейства изделий и сценарии использования</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">Этот раздел помогает выбрать подходящий тип изделия и быстрее сформировать запрос на расчет.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {familyProfiles.map((family) => (
          <div class="rounded-md border border-line-200 bg-white p-5">
            <p class="text-sm font-semibold text-ink-950">{family.title.ru}</p>
            <p class="mt-3 text-sm leading-6 text-steel-600">{family.summary.ru}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {family.bestFor.map((tag) => <span class="rounded-full bg-mist-100 px-3 py-1 text-xs font-medium text-graphite-800">{tag.ru}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist-100 py-16">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Изделия</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink-950">Варианты для расчета и обсуждения</h2>
        </div>
        <p class="text-base leading-7 text-steel-600">Каждое изделие адаптируется под материал, фирменные цвета, логотип, тираж, сроки и формат использования.</p>
      </div>
      {products.length > 0 ? (
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {products.slice(0, 9).map((product) => <ProductCard product={product} locale="ru" />)}
        </div>
      ) : (
        <div class="mt-10 rounded-md border border-line-200 bg-white p-6">
          <p class="text-base font-semibold text-ink-950">Для этого направления доступен индивидуальный подбор.</p>
          <p class="mt-3 text-sm leading-6 text-steel-600">Опишите задачу, желаемый материал, тираж и брендирование. Менеджер предложит подходящие варианты и подготовит расчет.</p>
        </div>
      )}
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-8 rounded-md bg-ink-950 p-8 text-white md:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass-500">Расчет партии</p>
        <h2 class="mt-3 text-3xl font-semibold text-white">Нужно подобрать изделие под ваш бренд?</h2>
        <p class="mt-4 max-w-3xl text-base leading-7 text-white/70">Отправьте тип изделия, примерный тираж, материалы, логотип и сроки. Менеджер уточнит детали и подготовит предложение.</p>
      </div>
      <a class="inline-flex min-h-12 items-center justify-center rounded-md bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-teal-600" href={briefHref}>Отправить запрос</a>
    </div>
  </section>
</BaseLayout>
