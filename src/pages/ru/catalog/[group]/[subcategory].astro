---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProductCard from "@components/ProductCard.astro";
import { catalogGroups } from "@data/catalog";
import { legacyProductFamilies, legacyProductMigration } from "@data/legacyMigration";
import { legacySubcategoryCoverage } from "@data/catalogCoverage";
import { products } from "@data/products";

export function getStaticPaths() {
  return legacySubcategoryCoverage.map((item) => {
    const group = catalogGroups.find((catalogGroup) => catalogGroup.id === item.groupId);
    if (!group) {
      throw new Error(`Missing catalog group for ${item.id}`);
    }

    return {
      params: {
        group: group.slug.ru,
        subcategory: item.slug.ru
      },
      props: { group, item }
    };
  });
}

const { group, item } = Astro.props;
const legacyLink = group.subcategories.find((subcategory) => subcategory.originalSlug === item.legacySlug);
const title = legacyLink?.label.ru ?? item.title;
const relevantFamilies = legacyProductFamilies.filter((family) => item.productFamilyIds.includes(family.id));
const legacyRecords = legacyProductMigration.filter((record) => item.productFamilyIds.includes(record.familyId));
const modeledProducts = products.filter((product) => product.categoryIds.includes(group.id) && item.productFamilyIds.includes(product.family));
const backlogCount = legacyRecords.filter((record) => record.migrationDecision === "family-reference-backlog").length;
const briefHref = `/ru/contact/?intent=subcategory-brief&category=${group.id}&subcategory=${item.id}`;
---

<BaseLayout
  locale="ru"
  path={`/ru/catalog/${group.slug.ru}/${item.slug.ru}/`}
  pathWithoutLocale={`catalog/${group.slug.ru}/${item.slug.ru}/`}
  title={`${title} | Aksessoriuz`}
  description={`B2B направление ${title}: референсы изделий, материалы, брендирование и проектный бриф для расчета.`}
>
  <section class="relative overflow-hidden bg-ink-950 py-16 text-white md:py-20">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_20%,rgba(28,120,103,0.35),transparent_34%),linear-gradient(135deg,#111827,#0f2f2a)]"></div>
    <div class="container-page relative">
      <a class="inline-flex text-sm font-semibold text-brass-500 transition hover:text-white" href={`/ru/catalog/${group.slug.ru}/`}>Назад в раздел</a>
      <p class="mt-6 text-sm font-semibold uppercase tracking-[0.18em] text-white/62">B2B product direction</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold text-white">{title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-white/74">
        Направление сохранено из текущего сайта и превращено в landing page для подбора референсов, обсуждения материалов, брендирования, тиража и сроков.
      </p>
      <div class="mt-8 grid gap-3 sm:grid-cols-3">
        <div class="rounded-md border border-white/12 bg-white/10 p-4">
          <p class="text-2xl font-semibold text-white">{legacyRecords.length}</p>
          <p class="mt-1 text-xs uppercase tracking-[0.14em] text-white/58">старых URL</p>
        </div>
        <div class="rounded-md border border-white/12 bg-white/10 p-4">
          <p class="text-2xl font-semibold text-white">{modeledProducts.length}</p>
          <p class="mt-1 text-xs uppercase tracking-[0.14em] text-white/58">референсов</p>
        </div>
        <div class="rounded-md border border-white/12 bg-white/10 p-4">
          <p class="text-2xl font-semibold text-white">{backlogCount}</p>
          <p class="mt-1 text-xs uppercase tracking-[0.14em] text-white/58">в backlog</p>
        </div>
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="inline-flex min-h-12 items-center justify-center rounded-md bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-teal-600" href={briefHref}>Обсудить проект</a>
        <a class="inline-flex min-h-12 items-center justify-center rounded-md border border-white/20 bg-white/10 px-5 text-sm font-semibold text-white transition hover:bg-white hover:text-ink-950" href={item.currentUrl}>Открыть исходный раздел</a>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Coverage map</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink-950">Что покрывает направление</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">Это не страница покупки. Она помогает выбрать ориентир для переговоров и передает менеджеру правильный контекст проекта.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {relevantFamilies.map((family) => (
          <div class="rounded-md border border-line-200 bg-white p-5">
            <p class="text-sm font-semibold text-ink-950">{family.title}</p>
            <p class="mt-3 text-xs leading-5 text-steel-600">SKU families: {family.skuCodes.join(", ")}</p>
            <p class="mt-3 text-xs font-semibold uppercase tracking-[0.14em] text-emerald-700">{legacyProductMigration.filter((record) => record.familyId === family.id).length} старых URL в manifest</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist-100 py-16">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Reference items</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink-950">Референсы для обсуждения</h2>
        </div>
        <p class="text-base leading-7 text-steel-600">Пока финальные карточки не утверждены, показываем доступные референсы из текущей базы и сохраняем остальные старые URL в migration backlog.</p>
      </div>
      {modeledProducts.length > 0 ? (
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {modeledProducts.slice(0, 9).map((product) => <ProductCard product={product} locale="ru" />)}
        </div>
      ) : (
        <div class="mt-10 rounded-md border border-line-200 bg-white p-6">
          <p class="text-base font-semibold text-ink-950">Финальные карточки для этого направления еще не утверждены.</p>
          <p class="mt-3 text-sm leading-6 text-steel-600">Направление сохранено в структуре и будет заполнено после передачи карточек, фото, материалов и условий производства.</p>
        </div>
      )}
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-8 rounded-md bg-ink-950 p-8 text-white md:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass-500">Project brief</p>
        <h2 class="mt-3 text-3xl font-semibold text-white">Нужен расчет по этому направлению?</h2>
        <p class="mt-4 max-w-3xl text-base leading-7 text-white/70">Отправьте ориентир, примерный тираж, материалы, логотип и сроки. Менеджер уточнит детали и подготовит расчет или предложение по образцу.</p>
      </div>
      <a class="inline-flex min-h-12 items-center justify-center rounded-md bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-teal-600" href={briefHref}>Отправить бриф</a>
    </div>
  </section>
</BaseLayout>
