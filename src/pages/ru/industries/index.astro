---
import ProductGroupCard from "@components/ProductGroupCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { catalogGroups } from "@data/catalog";

const industries = [
  {
    title: "Рестораны и кафе",
    description: "Меню, чекхолдеры, резервы, тейбл-тенты, плейсметы, салфетницы и деревянная посуда.",
    href: "/ru/catalog/restaurant-accessories/"
  },
  {
    title: "Гостиницы и hospitality",
    description: "Папки, меню, аксессуары сервиса, брендированные детали для номеров и гостевых зон.",
    href: "/ru/catalog/hotel-accessories/"
  },
  {
    title: "Корпоративные клиенты",
    description: "Бизнес-наборы, ежедневники, папки, бейджи, картхолдеры, подарки и аксессуары.",
    href: "/ru/catalog/business-products/"
  },
  {
    title: "Ритейл и упаковка",
    description: "Упаковка, сувенирная продукция, презентационные решения и брендированные комплекты.",
    href: "/ru/catalog/packaging-souvenirs/"
  },
  {
    title: "Команды и персонал",
    description: "Униформа, фартуки и текстильная продукция для ресторанов, отелей, офиса и событий.",
    href: "/ru/catalog/uniforms-textile/"
  },
  {
    title: "Производственные проекты",
    description: "УФ-печать, лазерная резка, тиснение, фольгирование, маркировка и столярное производство.",
    href: "/ru/services/"
  }
];
---

<BaseLayout locale="ru" path="/ru/industries/" pathWithoutLocale="industries/" title="Отрасли | Aksessoriuz" description="Решения Aksessoriuz для ресторанов, гостиниц, корпоративных клиентов, ритейла, команд и производственных проектов.">
  <section class="bg-mist-100 py-16">
    <div class="container-page">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Industries</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold text-ink-950 md:text-5xl">Решения по типу бизнеса</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-steel-600">Новая структура позволяет клиенту начинать не только с товара, но и со своей задачи: ресторан, отель, офис, ритейл, команда или отдельная производственная технология.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {industries.map((industry) => (
        <a class="rounded-md border border-line-200 bg-white p-5 transition hover:border-emerald-700" href={industry.href}>
          <h2 class="text-lg font-semibold text-ink-950">{industry.title}</h2>
          <p class="mt-2 text-sm leading-6 text-steel-600">{industry.description}</p>
          <span class="mt-4 inline-flex text-sm font-semibold text-emerald-700">Смотреть решения</span>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-mist-100 py-16">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink-950">Каталог остается универсальным</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">Один и тот же продукт может быть показан в нескольких сценариях, если он релевантен разным клиентам.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {catalogGroups.map((group) => (
          <ProductGroupCard
            title={group.title.ru}
            description={group.description.ru}
            href={`/ru/catalog/${group.slug.ru}/`}
            tags={group.tags.map((tag) => tag.ru)}
            ctaLabel="Открыть категорию"
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
