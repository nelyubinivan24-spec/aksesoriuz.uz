---
import BaseLayout from "@layouts/BaseLayout.astro";

const faqs = [
  {
    question: "Как запросить расчет?",
    answer: "Отправьте заявку через форму, телефон или мессенджер. Для точного расчета нужны изделие, количество, материал, логотип и желаемые сроки."
  },
  {
    question: "Можно ли сделать продукцию с логотипом?",
    answer: "Да. В структуре сохранены УФ-печать, лазерная резка и гравировка, тиснение, фольгирование, полиграфия и маркировка."
  },
  {
    question: "Есть ли готовый каталог с ценами?",
    answer: "Цена зависит от материала, тиража, размера и брендинга. На следующих этапах будет решен формат прайс-каталога."
  },
  {
    question: "Какие категории продукции доступны?",
    answer: "Ресторанные и гостиничные аксессуары, бизнес-продукция, упаковка, сувенирная продукция, униформа, текстиль и производственные услуги."
  },
  {
    question: "Можно ли заказать несколько видов изделий одной заявкой?",
    answer: "Да. Для нового сайта заложена логика списка запроса вместо обычной корзины, чтобы удобно рассчитывать B2B-проекты."
  }
];
---

<BaseLayout locale="ru" path="/ru/faq/" pathWithoutLocale="faq/" title="FAQ | Aksessoriuz" description="Ответы на частые вопросы о расчете, брендировании, каталоге, категориях продукции и заказе Aksessoriuz.">
  <section class="bg-mist-100 py-16">
    <div class="container-page">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">FAQ</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold text-ink-950 md:text-5xl">Частые вопросы</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-steel-600">Раздел сохранен из логики текущего сайта и будет расширяться по реальным вопросам клиентов.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page max-w-4xl">
      <div class="grid gap-4">
        {faqs.map((item) => (
          <article class="rounded-md border border-line-200 bg-white p-5">
            <h2 class="text-lg font-semibold text-ink-950">{item.question}</h2>
            <p class="mt-2 text-sm leading-6 text-steel-600">{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
