---
import ProductGroupCard from "@components/ProductGroupCard.astro";
import QuoteForm from "@components/QuoteForm";
import BaseLayout from "@layouts/BaseLayout.astro";
import { capabilities, catalogGroups } from "@data/catalog";
---

<BaseLayout
  locale="ru"
  path="/ru/"
  pathWithoutLocale=""
  title="Aksessoriuz — брендированная продукция, упаковка и аксессуары для бизнеса"
  description="Изготавливаем брендированную продукцию, упаковку, аксессуары и бизнес-подарки для ресторанов, отелей и компаний в Узбекистане."
>
  <section class="bg-mist-100 py-16 md:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Custom branded production</p>
        <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-tight text-ink-950 md:text-6xl">
          Брендированные детали для бизнеса, которые видят и держат в руках
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-steel-600">
          Производим меню, упаковку, корпоративные подарки, униформу и аксессуары с логотипом для ресторанов, отелей, ритейла и компаний.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="inline-flex min-h-12 items-center justify-center rounded-md bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-teal-600" href="/ru/contact/?intent=quote">Запросить расчет</a>
          <a class="inline-flex min-h-12 items-center justify-center rounded-md border border-line-200 bg-white px-5 text-sm font-semibold text-ink-950 transition hover:border-emerald-700" href="/ru/catalog/">Смотреть каталог</a>
        </div>
      </div>
      <QuoteForm client:idle locale="ru" source="home_hero" />
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink-950">Полная структура продукции</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">Сохраняем охват текущего сайта: ресторанные и гостиничные аксессуары, бизнес-продукцию, упаковку, униформу и производственные услуги.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {catalogGroups.map((group) => (
          <ProductGroupCard
            title={group.title.ru}
            description={group.description.ru}
            href={`/ru/catalog/${group.slug.ru}/`}
            tags={group.tags.map((tag) => tag.ru)}
            ctaLabel="Смотреть направление"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist-100 py-16 md:py-24">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink-950">Возможности производства</h2>
        <p class="mt-4 text-base leading-7 text-steel-600">В новом сайте сохраняем все service/capability направления текущего сайта и связываем их с товарами.</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {capabilities.map((item) => (
          <a class="rounded-md border border-line-200 bg-white p-5 transition hover:border-emerald-700" href={`/ru/services/${item.slug.ru}/`}>
            <h3 class="text-lg font-semibold text-ink-950">{item.title.ru}</h3>
            <p class="mt-2 text-sm leading-6 text-steel-600">{item.description.ru}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
