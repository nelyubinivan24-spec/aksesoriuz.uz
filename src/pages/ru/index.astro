---
import ProductGroupCard from "@components/ProductGroupCard.astro";
import ProductCard from "@components/ProductCard.astro";
import QuoteForm from "@components/QuoteForm";
import BaseLayout from "@layouts/BaseLayout.astro";
import { capabilities, catalogGroups } from "@data/catalog";
import { featuredProducts } from "@data/products";

const heroImage = "https://aksesoriuz.uz/data/uploads/module/structure/20/14/67b1ec2c1c6b3.webp";

const trustStats = [
  { value: "12+", label: "лет опыта" },
  { value: "1 500+", label: "довольных клиентов" },
  { value: "2013", label: "работаем с брендами" },
  { value: "B2B", label: "расчет под тираж" }
];

const discoveryPaths = [
  {
    title: "По типу бизнеса",
    description: "Рестораны, гостиницы, офисы, ритейл, корпоративные клиенты и команды.",
    href: "/ru/industries/"
  },
  {
    title: "По продукции",
    description: "Меню, папки, упаковка, бизнес-наборы, униформа и аксессуары.",
    href: "/ru/catalog/"
  },
  {
    title: "По технологии",
    description: "УФ-печать, лазер, тиснение, фольгирование, полиграфия и столярное производство.",
    href: "/ru/services/"
  }
];

const productionMethods = [
  "УФ-печать по разным материалам",
  "Лазерная резка и гравировка",
  "Тиснение и фольгирование",
  "Полиграфия и постпечатная обработка",
  "Столярное производство",
  "Текстиль и униформа под бренд"
];

const processSteps = [
  { step: "01", title: "Задача", text: "Уточняем продукт, тираж, материал, брендирование и сроки." },
  { step: "02", title: "Подбор", text: "Собираем оптимальную комплектацию под бизнес-задачу и бюджет." },
  { step: "03", title: "Производство", text: "Готовим макет, согласуем детали и запускаем партию." },
  { step: "04", title: "Передача", text: "Проверяем качество и передаем готовые изделия клиенту." }
];

const clientLogos = [
  { src: "https://aksesoriuz.uz/images/index/logos/istanbul.png", alt: "Istanbul" },
  { src: "https://aksesoriuz.uz/images/index/logos/testo.png", alt: "Testo" },
  { src: "https://aksesoriuz.uz/images/index/logos/elma.png", alt: "Elma" },
  { src: "https://aksesoriuz.uz/images/index/logos/strawberry.png", alt: "Strawberry" },
  { src: "https://aksesoriuz.uz/images/index/logos/schindler.png", alt: "Schindler" },
  { src: "https://aksesoriuz.uz/images/index/logos/masterfood.png", alt: "Masterfood" }
];
---

<BaseLayout
  locale="ru"
  path="/ru/"
  pathWithoutLocale=""
  title="Aksessoriuz — премиальная брендированная продукция для бизнеса"
  description="Изготавливаем премиальную брендированную продукцию, упаковку, аксессуары, униформу и бизнес-подарки для ресторанов, отелей и компаний в Узбекистане."
>
  <section class="relative overflow-hidden bg-ink-950 text-white">
    <img class="absolute inset-0 h-full w-full object-cover opacity-55" src={heroImage} alt="Брендированная продукция Aksessoriuz" loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/82 to-ink-950/30"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-ink-950 to-transparent"></div>
    <div class="container-page relative py-20 md:py-24 lg:py-28">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brass-500">Custom branded production</p>
        <h1 class="mt-5 text-4xl font-semibold leading-tight text-white md:text-6xl">
          Брендированная продукция для бизнеса
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/78">
          Производим меню, упаковку, корпоративные подарки, униформу и аксессуары с логотипом для ресторанов, отелей, ритейла и компаний. Новая структура сохраняет весь охват текущего сайта и ведет клиента к заявке.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="inline-flex min-h-12 items-center justify-center rounded-md bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-teal-600" href="/ru/contact/?intent=quote">Запросить расчет</a>
          <a class="inline-flex min-h-12 items-center justify-center rounded-md border border-white/25 bg-white/10 px-5 text-sm font-semibold text-white backdrop-blur transition hover:border-brass-500 hover:bg-white/15" href="/ru/catalog/">Смотреть каталог</a>
        </div>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-md border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
        {trustStats.map((item) => (
          <div class="bg-ink-950/55 p-5 backdrop-blur">
            <span class="block text-3xl font-semibold text-white">{item.value}</span>
            <span class="mt-1 block text-sm text-white/68">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-line-200 bg-white py-10">
    <div class="container-page grid gap-4 md:grid-cols-3">
      {discoveryPaths.map((path) => (
        <a class="rounded-md border border-line-200 bg-white p-5 transition hover:border-emerald-700 hover:shadow-lg" href={path.href}>
          <h2 class="text-lg font-semibold text-ink-950">{path.title}</h2>
          <p class="mt-2 text-sm leading-6 text-steel-600">{path.description}</p>
          <span class="mt-4 inline-flex text-sm font-semibold text-emerald-700">Открыть направление</span>
        </a>
      ))}
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Draft product cards</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink-950 md:text-4xl">Черновая витрина товаров</h2>
        </div>
        <p class="text-base leading-7 text-steel-600">Пока финальных карточек нет, используем реальные товары и изображения с текущего сайта как временный слой. Это позволяет проверить каталог, карточки, SEO-страницы и заявку уже сейчас.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {featuredProducts.map((product) => <ProductCard product={product} locale="ru" />)}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Catalog architecture</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink-950 md:text-4xl">Полная структура продукции</h2>
        </div>
        <p class="text-base leading-7 text-steel-600">Сохраняем охват текущего сайта: ресторанные и гостиничные аксессуары, бизнес-продукцию, упаковку, сувенирную продукцию, униформу и производственные услуги.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {catalogGroups.map((group) => (
          <ProductGroupCard
            title={group.title.ru}
            description={group.description.ru}
            href={`/ru/catalog/${group.slug.ru}/`}
            tags={group.tags.map((tag) => tag.ru)}
            ctaLabel="Смотреть направление"
            imageSrc={group.image.src}
            imageAlt={group.image.alt.ru}
            eyebrow={group.priority === "high" ? "Приоритет" : "Производство"}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink-950 py-16 text-white md:py-24">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass-500">Production capabilities</p>
          <h2 class="mt-3 text-3xl font-semibold text-white md:text-4xl">Возможности производства</h2>
        </div>
        <p class="text-base leading-7 text-white/70">Все service/capability направления текущего сайта сохранены как отдельные входы в воронку: клиент может прийти через продукт, материал или технологию.</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-5">
        {capabilities.map((item) => (
          <a class="group overflow-hidden rounded-md border border-white/10 bg-white/5 transition hover:-translate-y-1 hover:border-brass-500" href={`/ru/services/${item.slug.ru}/`}>
            <div class="aspect-[4/3] overflow-hidden bg-black">
              <img class="h-full w-full object-cover opacity-80 transition duration-500 group-hover:scale-105 group-hover:opacity-100" src={item.image.src} alt={item.image.alt.ru} loading="lazy" decoding="async" />
            </div>
            <div class="p-4">
              <h3 class="text-base font-semibold text-white">{item.title.ru}</h3>
              <p class="mt-2 text-xs leading-5 text-white/62">{item.description.ru}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist-100 py-16 md:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Materials and methods</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink-950 md:text-4xl">Премиальность создается материалом, точностью и контролем деталей</h2>
        <p class="mt-5 text-base leading-7 text-steel-600">Дизайн сайта должен показывать не только список товаров, но и производственную компетенцию: чем наносится логотип, как выглядит материал, для какой задачи изделие подходит.</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {productionMethods.map((method) => (
          <div class="rounded-md border border-line-200 bg-white p-4">
            <span class="text-sm font-semibold text-ink-950">{method}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Process</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink-950 md:text-4xl">От заявки до готовой партии</h2>
          <p class="mt-5 text-base leading-7 text-steel-600">Процесс должен снимать риск для B2B-клиента: понятно, что будет после заявки и кто контролирует результат.</p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          {processSteps.map((item) => (
            <article class="rounded-md border border-line-200 bg-white p-5">
              <span class="text-sm font-semibold text-brass-500">{item.step}</span>
              <h3 class="mt-3 text-lg font-semibold text-ink-950">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-steel-600">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist-100 py-16 md:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_0.9fr] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Client proof</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink-950 md:text-4xl">Доверие усиливаем реальными клиентами и изделиями</h2>
        <p class="mt-5 text-base leading-7 text-steel-600">Логотипы с текущего сайта сохранены как стартовый proof-layer. На следующем этапе их нужно дополнить кейсами, фотографиями партий и описанием задач.</p>
        <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {clientLogos.map((logo) => (
            <div class="grid min-h-20 place-items-center rounded-md border border-line-200 bg-white p-4">
              <img class="max-h-10 w-auto opacity-80 grayscale" src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      </div>
      <QuoteForm client:idle locale="ru" source="home_premium_final" />
    </div>
  </section>
</BaseLayout>
